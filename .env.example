# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. .env.local 은 저장소에 올라가지 않습니다.

# 메일을 보낼 Gmail 주소와 앱 비밀번호 (구글 계정 > 보안 > 2단계 인증 > 앱 비밀번호)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# 값이 있으면 테스트 모드: 받는 사람과 상관없이 이 주소로만 보냅니다. 실제 발송할 때는 비워 두세요.
MAIL_TEST_RECIPIENT=

# 값이 있으면 발송할 때 화면에서 이 암호를 입력해야 합니다 (공개 데모 주소 악용 방지)
SEND_PASSCODE=
